RAG_API_URL=http://127.0.0.1:8000/api
# Optional comma-separated WhatsApp chat IDs, such as 923001234567@c.us
ALLOWED_CHAT_IDS=
# Required for /send. Use /myid to find your ID; comma-separate multiple owners.
OWNER_CHAT_IDS=
# When no owner is configured, securely persist the first private sender as owner.
AUTO_CLAIM_OWNER=true
# Used to normalize local numbers such as 03001234567 -> 923001234567
DEFAULT_COUNTRY_CODE=92
MAX_FILE_MB=20
